# ============================================================
# AIscentra Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenRouter ───────────────────────────────────────────────
# Get from: https://openrouter.ai/keys
# Used by: Signal Engine, Event Generator, Content Agent, Assistant
OPENROUTER_API_KEY=sk-or-your-key-here

# Model to use for signal enrichment — pinned for scoring consistency
# Signal Scoring Specification v1.0: temperature=0, model pinned
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment: development | production
NODE_ENV=development

# ── Admin ────────────────────────────────────────────────────
# Email address allowed to access the admin interface
# Readiness Assessment Blocker B-02: admin auth must be defined before Stage 2
ADMIN_EMAIL=admin@aiscentra.com

# ── Cron Security ─────────────────────────────────────────────
# Secret for authenticating cron job requests
# Generate: openssl rand -hex 32
# Set same value in Vercel → Settings → Environment Variables
CRON_SECRET=your-random-secret-here

# ── Phase 1A: API Containment (Emergency) ──────────────────────
# These gate cost-sensitive/privileged routes. Fail-closed: if any of
# these is missing or misconfigured, the corresponding route denies
# all requests rather than allowing them through. See
# src/lib/security/api-access.ts for the full access model.

# Enables POST /api/agent. Must be the literal string "true" to enable —
# any other value (including unset) keeps the route disabled.
ENABLE_INTERNAL_AGENT_API=false

# Bearer secret required by POST /api/agent when ENABLE_INTERNAL_AGENT_API=true.
# Generate: openssl rand -hex 32 (recommended minimum: 32 characters).
# Left empty here deliberately — an empty, whitespace-only, or placeholder
# value is treated as "not configured" and fails closed (see
# src/lib/security/api-access.ts).
INTERNAL_API_SECRET=

# Enables POST /api/admin/simulate-engine-v2. Must be the literal string
# "true" to enable — any other value (including unset) keeps the route disabled.
ENABLE_ENGINE_SIMULATION=false

# Bearer secret required by POST /api/admin/simulate-engine-v2 when
# ENABLE_ENGINE_SIMULATION=true. Generate: openssl rand -hex 32
# (recommended minimum: 32 characters). Left empty here deliberately — see
# INTERNAL_API_SECRET above for why.
ADMIN_API_SECRET=

# Controls whether the public /api/assistant endpoint responds at all.
# Allowed values: "disabled" | "preview-only". Any other value (including
# unset) is treated as "disabled". "preview-only" is only honored outside
# Vercel production (VERCEL_ENV=production always forces disabled,
# regardless of this value) — it exists for Preview deployments and local
# development only.
PUBLIC_ASSISTANT_ACCESS_MODE=disabled
